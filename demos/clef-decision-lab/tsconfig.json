{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["bun", "vite/client"],
    "baseUrl": ".",
    "paths": { "@/*": ["apps/web/src/*"] }
  },
  "include": ["apps/**/*.ts", "apps/**/*.vue", "packages/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
}

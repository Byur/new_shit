{
  "name": "clef-decision-lab",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "server": "bun --watch apps/server/src/index.ts",
    "web": "vite --config apps/web/vite.config.ts",
    "check": "vue-tsc --noEmit -p tsconfig.json",
    "build": "bun run check && vite build --config apps/web/vite.config.ts",
    "test": "bun test",
    "verify:live": "bun scripts/verify-live.ts"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "hono": "^4.10.0",
    "jsonc-parser": "^3.3.1",
    "lucide-vue-next": "^0.468.0",
    "reka-ui": "^2.5.0",
    "tailwind-merge": "^3.3.1",
    "vue": "3.5.22",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/bun": "^1.3.0",
    "@types/node": "^24.0.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "tailwindcss": "^4.1.16",
    "typescript": "~5.9.3",
    "vite": "^7.2.2",
    "vue-tsc": "^3.1.3"
  }
}

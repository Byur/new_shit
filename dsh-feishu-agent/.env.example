# 复制成 .env 放在**仓库根目录**（推荐）或本插件目录，然后填写。
#
# `.env` 被仓库根 .gitignore 的 `.env` 规则忽略，不会进版本库；写完用 `git status` 确认看不到它。
# 读取顺序：项目根（上游第一个有 .git 的目录）→ 本插件目录，先读到的键赢；
# 真实的进程环境变量（launchctl / 登录项）永远最高。
# 插件只接纳 FEISHU_AGENT_* 与 *_API_KEY（provider key）：根 .env 里别的工具密钥不会被带进来。
# 不要用 DSH_ 前缀：dsh 自己禁止项目 .env 设置任何 DSH_*，会让它启动的 CLI 子进程直接报错退出。
# 留空的键按「没写」处理，不会盖住别处；文件缺失也不报错。

# ===== 飞书应用凭据（必填）=====
# 开发者后台 → 你的应用 → 凭证与基础信息
FEISHU_AGENT_APP_ID=
FEISHU_AGENT_APP_SECRET=

# ===== 会话归属：消息落到哪个 Workspace =====
# 所有没单独配置的私聊都走这一套，等价于配置里的 chats['*']。
FEISHU_AGENT_DEFAULT_WORKSPACE=
# 可选：上面这组默认值的其余字段
# FEISHU_AGENT_DEFAULT_TITLE_PREFIX=[飞书]
# FEISHU_AGENT_DEFAULT_PERMISSION_PRESET=workspace-write
# FEISHU_AGENT_DEFAULT_AGENT_PRESET=standard

# 可选：owner 的 open_id；留空则由第一条私聊自举
# FEISHU_AGENT_OWNER_OPEN_ID=

# 可选：给某个 chat 单独指定目录/群聊策略，一行 JSON（精确 chat_id 优先于默认值）
# 群聊示例：{"oc_群id":{"workspacePath":"/path","chatType":"group","permissionPreset":"read-only","allowSenders":["ou_xxx"]}}
# FEISHU_AGENT_CHATS={"oc_xxx":{"workspacePath":"/path/to/workspace","titlePrefix":"[私人]"}}

# 可选：同时最多跑几条会话，≥1 的整数，默认 3
# FEISHU_AGENT_ANSWER_CONCURRENCY=3

# ===== 群聊 =====
# owner 在群里 @ 机器人后，确认卡里「允许」接入的目标目录。
# 不写就退回私聊通配 chats['*'].workspacePath；建议给群单独一个目录。
# FEISHU_AGENT_GROUP_WORKSPACE=/path/to/group-workspace
# 关掉「owner @ 之后私聊发接入确认卡」的动态接入（默认开）
# FEISHU_AGENT_GROUP_REGISTRATION=on

# ===== 一轮由谁执行 =====
# auto（默认）：新会话先让 Desktop 宿主建/跑，接不住会记住并退回 CLI，不再每条都重试。
# cli：只走 CLI（桌面端打开同一条会话会撞写句柄）。host：只走宿主，接不住直接报失败。
# FEISHU_AGENT_TURN_MODE=auto
# 等宿主认领这一轮的时长（毫秒，默认 8000）
# FEISHU_AGENT_HOST_TURN_TIMEOUT_MS=8000

# 回答里的 ![alt](路径) 是否转成卡片内嵌图片（默认开；off 则原样保留 markdown）
# FEISHU_AGENT_INLINE_IMAGES=on

# ===== 意图路由（可选；推荐用 local-config.json 热加载）=====
# 三条路由：dsh（复杂任务，4.1 Flash）/ local（简单应答，本地 Qwen3）/ obsidian（速记进待整理）。
# 这些平铺变量会覆盖 local-config.json 里的同名字段；改完要重启 Desktop。
# 总开关（on/off，默认 off）；开之前先确认 Ollama 已跑 qwen3:8b
# FEISHU_AGENT_ROUTER_ENABLED=off
# 本地 Ollama 地址
# FEISHU_AGENT_OLLAMA_URL=http://127.0.0.1:11434
# 分类器模型
# FEISHU_AGENT_ROUTER_MODEL=qwen3:8b
# 待整理写入目录（本机路径，留空则 obsidian 路由自动降级走 dsh）
# FEISHU_AGENT_OBSIDIAN_INBOX_DIR=
# 写入前的本地处理开关（on/off，默认 on）：清噪由确定性规则完成，只在需要断句时才调用本地模型
# FEISHU_AGENT_POLISH_ENABLED=on
# 单次断句超时（毫秒，300~30000，默认 6000）
# FEISHU_AGENT_POLISH_TIMEOUT_MS=6000
# 允许调用模型断句的最大原文长度（字符，100~2000，默认 300；超出只跳过模型，规则清噪照做）
# FEISHU_AGENT_POLISH_MAX_CHARS=300
# 允许调用模型断句的最大条数（1~20，默认 6；超出只跳过模型，规则清噪照做）
# FEISHU_AGENT_POLISH_MAX_ITEMS=6
# 旧 FEISHU_AGENT_DISTILL_ENABLED / _TIMEOUT_MS / _MAX_CHARS 已废弃，仅兼容
# 本地分类器健康嗅探开关（on/off，默认 on）：不可用时直接降级 dsh，不等分类超时
# FEISHU_AGENT_HEALTH_ENABLED=on
# 健康探测结果缓存时长（毫秒，1000~600000，默认 30000）
# FEISHU_AGENT_HEALTH_TTL_MS=30000
# 连续失败熔断后的冷却时长（毫秒，1000~600000，默认 60000）
# FEISHU_AGENT_HEALTH_COOLDOWN_MS=60000

# ===== 其它可选 =====
# 插件状态目录（默认 $DSH_HOME/feishu-agent）
# FEISHU_AGENT_STATE_DIR=
# CLI 子进程用的 DSH_HOME（Desktop 沙箱下子进程写不了自己的 profile 时用）
# FEISHU_AGENT_CLI_HOME=
# CLI 子进程要用的 provider key（apiKeyEnv 只认进程环境变量；会被子进程继承）
# DEEPSEEK_API_KEY=
# 换一个 .env 路径（绝对路径，或相对进程当前目录）
# FEISHU_AGENT_ENV_FILE=

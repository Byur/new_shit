{
  "name": "dsh-feishu-agent",
  "version": "0.1.0",
  "private": true,
  "description": "个人 Agent 的飞书入口：飞书长连接把私聊消息投进 DSH Desktop 宿主内的会话（按 Workspace 归属），回答以卡片回流，反问与工具审批可在飞书作答，定时任务可主动联系用户。",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "check": "node --check lib/index.js && for f in $(find lib -name '*.js'); do node --check \"$f\" || exit 1; done",
    "test": "node --test test/*.test.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.19.0",
    "@larksuiteoapi/node-sdk": "^1.76.0"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.1 <0.3"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}

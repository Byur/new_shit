{
  "name": "context-hub",
  "version": "0.1.0",
  "private": true,
  "description": "A local SQLite-backed archive for scheduled-workspace context, reports, and compact memory.",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "scripts": {

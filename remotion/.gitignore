# Package-local dependencies and local configuration
node_modules/
.env
.env.*
.DS_Store

# TypeScript / tooling caches
*.tsbuildinfo
.cache/
dist/

# Package-local Remotion build and render artifacts
build/
out/
output/

# Generated narration masters. They are a build input for rendering, but they are
# reproducible from src/<project>/narration.script.json on macOS:
#   npm run narration:build -- --project coffee
# Note: public/deepseek-harness-plugins-narration.wav predates this rule and is
# already tracked, so it stays in the repository.
public/*-narration.wav

# public/maplibre-gl-worker.mjs IS tracked on purpose: MapLibre ships its worker
# in its own dist, so keeping a copy in public/ removes unpkg.com from the render
# path. It is one file and needs no build step.
#
# The basemap itself is NOT baked. Doing so saved only ~19 % of render time
# because the network was never the bottleneck; the render fetches the style,
# glyphs and 1.3 MB of tiles from demotiles.maplibre.org instead.


# public/tacoma/* IS tracked on purpose. Those stills are public domain and the
# film needs them to render; scripts/fetch-tacoma-assets.mjs can re-download the
# originals, and docs/tacoma-narrows-bridge.md records source and licence.
